DEMO_MODE=true
COOKIE_SECURE=false
# Optional MongoDB connection check. Keep DATABASE_URL for application data.
MONGODB_URI=
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/campuspath
# Install psycopg[binary] before selecting PostgreSQL.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional semantic retrieval. Each database must use its own Qdrant collection.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=campuspath
# Optional speech providers; OpenAI-compatible endpoints.
SPEECH_BASE_URL=
SPEECH_API_KEY=
STT_MODEL=
TTS_MODEL=
TTS_VOICE=
OCR_LANGUAGE=eng

# Larger books: raise cautiously; accepted range 1–64 MiB.
MAX_UPLOAD_MIB=8
MAX_PDF_PAGES=1200
MAX_EXTRACTED_CHARS=5000000

# Optional first administrator on hosted deployments. Remove the password after setup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
